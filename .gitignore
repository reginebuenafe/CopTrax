# ── Logs ────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Dependencies ─────────────────────────────────────────────
node_modules/
frontend/node_modules/

# ── Build outputs ────────────────────────────────────────────
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
*.local

# ── Environment / secrets (NEVER commit these) ───────────────
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ── Vite cache ───────────────────────────────────────────────
.vite/
frontend/.vite/

# ── Supabase local dev artifacts ─────────────────────────────
supabase/.temp/
supabase/.branches/

# ── macOS ────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Editor / IDE directories ─────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.cursor/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── AI assistant / tooling workspace files ───────────────────
# .claude/ contains Copilot session context — keep skills & config committed
# but exclude per-session/private state
.claude/
.impeccable/

# ── OS / system files ────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

